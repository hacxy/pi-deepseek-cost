{
  "name": "pi-deepseek-cost",
  "version": "0.1.0",
  "description": "DeepSeek usage & cost tracker for Pi — live session cost in the status bar, /ds-cost and /ds-estimate overlay panels, bilingual UI, peak/off-peak pricing support",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "deepseek",
    "cost",
    "usage",
    "ai",
    "agents",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hacxy/pi-deepseek-cost.git"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/hacxy/pi-deepseek-cost/main/screenshots/ds-cost-en.png"
  },
  "scripts": {
    "dev": "pi -e ./src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@hacxy/eslint-config": "^0.6.0",
    "@hacxy/prettier-config": "^0.0.6",
    "@hacxy/tsconfig": "^0.1.6",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
