{
  "name": "tpl-pi-extension",
  "version": "1.0.0",
  "description": "A Pi extension project",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "ai",
    "agents",
    "cli"
  ],
  "type": "module",
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "dev": "pi -e ./src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
