{
  "name": "tpl-pi-extension",
  "version": "0.0.0",
  "description": "A Pi extension project",
  "keywords": ["pi-package", "pi-extension", "pi", "pi-coding-agent", "ai", "agents", "cli"],
  "type": "module",
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "dev": "pi -e ./src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@earendil-works/pi-coding-agent": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": "biome check --write"
  }
}
